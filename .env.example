# Gmail credentials for sending reminder emails
# Use a Gmail App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where reminder emails get sent (probably your own email)
ADMIN_EMAIL=you@gmail.com

# The public URL of your site (used in reminder email links)
SITE_URL=http://localhost:5174

# Admin password for the admin page
ADMIN_PASSWORD=changeme

# Port for the server
PORT=3002

# DynamoDB table name (created by CDK)
DYNAMODB_TABLE=hoops-signup
